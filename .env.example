# Kuchi configuration. Copy to .env (git-ignored) and fill in.
# Every public URL derives from KUCHI_BASE_URL (WHITELABEL.md section 6).
# scripts/build_site.py and scripts/verify_site.py read it at build time, and
# scripts/rebrand.py uses it when rewriting upstream strings.

KUCHI_BASE_URL=https://kuchi.kalarislabs.com
KUCHI_MCP_URL=${KUCHI_BASE_URL}/mcp
# GitHub owner/repo the MCP reads its live catalog from (posters load from it too).
KUCHI_REPO=kalarislabs/kuchi
KUCHI_SUPPORT_EMAIL=support@kalarislabs.com

# Cloudflare: wrangler reads this instead of a hard-coded account_id.
CLOUDFLARE_ACCOUNT_ID=

# Clerk (agent-service). The publishable key goes in agent-service/wrangler.json
# vars; the secret goes in with `wrangler secret put CLERK_SECRET_KEY`.
CLERK_ISSUER=https://clerk.kuchi.kalarislabs.com
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PostHog (optional). Leave empty to keep analytics off.
POSTHOG_PROJECT_TOKEN=
