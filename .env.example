# Kuchi configuration. Copy to .env (git-ignored) and fill in.
# Every public URL derives from KUCHI_BASE_URL.
# scripts/build_site.py and scripts/verify_site.py read it at build time.

KUCHI_BASE_URL=https://kuchi.kalarislabs.com
KUCHI_MCP_URL=${KUCHI_BASE_URL}/mcp
# GitHub owner/repo the MCP reads its live catalog from (posters load from it too).
KUCHI_REPO=kalarislabs/kuchi
KUCHI_SUPPORT_EMAIL=support@kalarislabs.com

# Cloudflare: wrangler reads this instead of a hard-coded account_id.
CLOUDFLARE_ACCOUNT_ID=


# PostHog (optional). The project token is public by design, so it lives in the
# Worker configs, not here: set POSTHOG_PROJECT_TOKEN in web/wrangler.jsonc (the
# site) and agent-service/wrangler.json (the MCP server). Set it to "" to keep
# analytics off.
