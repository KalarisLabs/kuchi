{
  "name": "kuchi-agent",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "kuchi.kalarislabs.com/mcp",
      "zone_name": "kalarislabs.com"
    },
    {
      "pattern": "kuchi.kalarislabs.com/mcp/health",
      "zone_name": "kalarislabs.com"
    },
    {
      "pattern": "kuchi.kalarislabs.com/agent",
      "zone_name": "kalarislabs.com"
    },
    {
      "pattern": "kuchi.kalarislabs.com/agent/*",
      "zone_name": "kalarislabs.com"
    },
    {
      "pattern": "kuchi.kalarislabs.com/.well-known/openai-apps-challenge",
      "zone_name": "kalarislabs.com"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "IP_LIMITER",
        "class_name": "IpRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "IpRateLimiter"
      ]
    }
  ],
  "vars": {
    "POSTHOG_PROJECT_TOKEN": "phc_BaUCoMX79564auphbhPunCevdRfmVCzVRqk6Tdjz69kq",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "OPENAI_APPS_CHALLENGE": ""
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "kuchi-bucket"
    }
  ]
}
