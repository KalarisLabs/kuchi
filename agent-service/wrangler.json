{
  "name": "kuchi-agent",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "ARCHIVE_REQUEST_LIMITER",
      "namespace_id": "2026110501",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "kuchi.kalarislabs.com/mcp",
      "zone_name": "kalarislabs.com"
    },
    {
      "pattern": "kuchi.kalarislabs.com/mcp/health",
      "zone_name": "kalarislabs.com"
    },
    {
      "pattern": "kuchi.kalarislabs.com/agent",
      "zone_name": "kalarislabs.com"
    },
    {
      "pattern": "kuchi.kalarislabs.com/agent/*",
      "zone_name": "kalarislabs.com"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
