---
// "Connect your agent": client cards with Install links, the MCP card (server URL and
// setup prompt), the skill install card and resources.
//
// The connect script (scripts/connect.js, kept identical to ../site/connect.js) still drives
// this section through the hooks the old panel had, so they must stay:
//   - #setup-command / #copy-setup: the setup prompt and its copy button;
//   - a.client-link[data-client=claude|claude-code|codex]: the script swaps their hrefs for
//     desktop deep links carrying the full setup prompt (the hrefs below are the no-JS
//     fallbacks); data-client values are also what analytics records;
//   - button[data-client="more"] + #client-setup: the "More agents" list the script renders.
// The new copy buttons are wired by the small script at the bottom.
const MCP_URL = 'https://kuchi.kalarislabs.com/mcp';
const SKILL_URL = 'https://kuchi.kalarislabs.com/agent/SKILL.md';
const shortPrompt = encodeURIComponent(`Connect to Kuchi MCP at ${MCP_URL}.`);
const claudeWeb = 'https://claude.ai/customize/connectors?' + new URLSearchParams({ modal: 'add-custom-connector', connectorName: 'Kuchi', connectorUrl: MCP_URL });

interface Row {
  label: string;
  icon: string;
  href: string;
  client?: string; // data-client, for the script and analytics
  quick?: boolean; // a quick-connect link the script updates (class="client-link")
  title?: string;
  brandColor?: boolean;
  external?: boolean;
  action?: string;
}
interface Group { title: string; rows: Row[] }

const groups: Group[] = [
  { title: 'Claude', rows: [
    { label: 'Claude', client: 'claude', quick: true, href: `claude://claude.ai/new?q=${shortPrompt}`, icon: '/logos/claude.svg', brandColor: true, title: 'Open Claude Desktop with the setup prompt' },
    { label: 'Claude Code', client: 'claude-code', quick: true, href: `claude://code/new?q=${shortPrompt}`, icon: '/logos/claude.svg', brandColor: true, title: 'Open Claude Code in the desktop app with the setup prompt' },
    { label: 'Claude on the web', client: 'claude-web', href: claudeWeb, icon: '/logos/claude.svg', brandColor: true, external: true, title: 'Add Kuchi as a custom connector on claude.ai' },
  ] },
  { title: 'Codex + ChatGPT', rows: [
    { label: 'Codex', client: 'codex', quick: true, href: `codex://new?prompt=${shortPrompt}`, icon: '/logos/codex.svg', title: 'Open Codex with the setup prompt' },
    { label: 'ChatGPT', href: 'https://chatgpt.com/plugins', icon: '/logos/chatgpt.svg', external: true, action: 'Set up', title: 'In Plugins, add a custom MCP server with the URL on the right, no authentication' },
  ] },
  { title: 'Cursor + Grok', rows: [
    { label: 'Cursor', client: 'cursor', quick: true, href: 'https://cursor.com/en/install-mcp?name=kuchi&config=eyJ1cmwiOiJodHRwczovL2t1Y2hpLmthbGFyaXNsYWJzLmNvbS9tY3AifQ%3D%3D', icon: '/logos/cursor.svg', external: true },
    { label: 'Grok', href: 'https://grok.com/connectors', icon: '/logos/grok.svg', external: true, action: 'Set up', title: 'In Connectors, add a custom connector with the URL on the right' },
  ] },
];

// The skill install commands: universal agent install (skills.sh) and Claude Code plugin.
// The raw curl/Invoke-WebRequest download commands were removed on owner instruction (2026-11-14); do not add them back.
const universalSkill = { command: 'npx skills add kalarislabs/kuchi', note: 'Installs into .agents/skills/kuchi for Claude, Cursor, Codex, Antigravity, and Gemini.' };
const claudePlugin = { label: 'Claude Code', command: '/plugin install kuchi --marketplace KalarisLabs/kuchi', note: 'Installs the skill and MCP server together.' };

const resources = [
  { label: 'Follow @sayanchowdhuryai on X', href: 'https://x.com/sayanchowdhuryai', external: true, icon: 'x' },
  { label: 'Setup guide', href: 'https://github.com/kalarislabs/kuchi/blob/main/agent/README.md', external: true, icon: 'book' },
  { label: 'Help & support', href: '/support', icon: 'help' },
];
const copyIcon = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M15 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h3"/></svg>';
const icons: Record<string, string> = {
  x: '<path d="M4 4l16 16M20 4 4 20" />',
  book: '<path d="M4 5a2 2 0 0 1 2-2h5v17H6a2 2 0 0 0-2 2Zm16 0a2 2 0 0 0-2-2h-5v17h5a2 2 0 0 1 2 2Z"/>',
  help: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14M12 17.5h.01"/>',
  code: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/>',
};
---
<section class="agent-connect section numbered" id="connect" data-line="003" aria-labelledby="connect-title">
  <div class="connect-heading"><h2 id="connect-title">Connect your agent.</h2><p class="connect-sub">One click for most agents. No sign-in, no API key.</p></div>

  <div class="connect-grid">
    <div class="connect-col">
      {groups.map((group) => (
        <div class="connect-card">
          <h3 class="connect-card-title">{group.title}</h3>
          <ul class="connect-rows">
            {group.rows.map((row) => (
              <li class="connect-row">
                <span class="connect-row-name"><img class:list={['brand-icon', { 'brand-color': row.brandColor }]} src={row.icon} alt="" aria-hidden="true" width="20" height="20">{row.label}</span>
                {row.quick
                  ? <a class="client-link" data-client={row.client} href={row.href} title={row.title} target={row.external ? '_blank' : undefined} rel={row.external ? 'noopener' : undefined}>Install <span aria-hidden="true">↗</span></a>
                  : <a class="connect-install" data-client={row.client} href={row.href} title={row.title} target={row.external ? '_blank' : undefined} rel={row.external ? 'noopener' : undefined}>{row.action ?? 'Install'} <span aria-hidden="true">↗</span></a>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="connect-col">
      <div class="connect-card">
        <h3 class="connect-card-title">MCP</h3>
        <div class="connect-code"><span class="connect-code-label">URL</span><code>{MCP_URL}</code><button type="button" class="connect-copy" data-copy-text={MCP_URL} aria-label="Copy MCP server URL" title="Copy MCP server URL" set:html={copyIcon} /></div>
        <p class="connect-hint">Or paste this prompt into any agent:</p>
        <div class="setup-prompt"><code id="setup-command">Connect the Kuchi MCP server at {MCP_URL} (no sign-in) and use its videos as templates for my launch video.</code><button id="copy-setup" aria-label="Copy agent setup prompt" title="Copy setup prompt"><Fragment set:html={copyIcon} /><span class="sr-only">Copy</span></button></div>
      </div>

      <div class="connect-card">
        <div class="connect-card-head"><h3 class="connect-card-title">Install the skill</h3><a class="connect-review" href={SKILL_URL} target="_blank" rel="noopener">Review skill <span aria-hidden="true">↗</span></a></div>
        <p class="connect-hint connect-hint-first">Universal (skills.sh):</p>
        <div class="connect-code connect-code-cmd"><code>{universalSkill.command}</code><button type="button" class="connect-copy" data-copy-text={universalSkill.command} aria-label="Copy universal install command" title="Copy command" set:html={copyIcon} /></div>
        <p class="connect-hint">In {claudePlugin.label}:</p>
        <div class="connect-code connect-code-cmd"><code>{claudePlugin.command}</code><button type="button" class="connect-copy" data-copy-text={claudePlugin.command} aria-label={`Copy ${claudePlugin.label} install command`} title="Copy command" set:html={copyIcon} /></div>
        <p class="connect-hint connect-hint-last">{universalSkill.note}</p>
      </div>

      <div class="connect-card">
        <h3 class="connect-card-title">Resources</h3>
        <ul class="connect-rows">
          {resources.map((r) => (
            <li><a class="connect-resource" href={r.href} target={r.external ? '_blank' : undefined} rel={r.external ? 'noopener' : undefined}><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[r.icon]} />{r.label}<span class="connect-resource-arrow" aria-hidden="true">↗</span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="connect-card connect-more">
    <div class="quick-connect"><span>VS Code, Gemini CLI, Codex CLI, Raft and any other MCP client</span><div class="client-buttons" aria-label="More agents"><button data-client="more" aria-expanded="false" aria-controls="client-setup">More agents <span>+</span></button></div></div>
    <div id="client-setup" class="client-setup" hidden role="region" aria-live="polite" aria-label="Connection instructions"></div>
  </div>

  <details class="mcp-explainer"><summary>Skill or MCP?</summary><p>Use both. The skill teaches your agent the Kuchi workflow; MCP gives it the latest collection each time, because Kalaris Labs adds videos daily, without reinstalling anything. <a href="/agent/SKILL.md">Setup guide ↗</a></p></details>
</section>

<script>
  import '../scripts/connect.js';
</script>
<script>
  // New in the card layout (connect.js stays a verbatim port): the copy buttons.
  const toast = document.getElementById('toast');
  const say = (text: string, ms = 2000) => {
    if (!toast) return;
    toast.textContent = text;
    toast.classList.add('visible');
    setTimeout(() => toast.classList.remove('visible'), ms);
  };
  for (const button of document.querySelectorAll<HTMLButtonElement>('#connect [data-copy-text]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyText ?? '');
        button.dataset.copied = 'true';
        setTimeout(() => button.removeAttribute('data-copied'), 2000);
        say('Copied to clipboard');
      } catch {
        say('Copy unavailable. Select and copy the text.', 3500);
      }
    });
  }
</script>
