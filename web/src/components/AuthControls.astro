---
import { Show, UserButton, SignInButton, SignUpButton } from '@clerk/astro/components';
---
<div class="ml-auto flex items-center gap-3 font-[var(--mono)] text-sm">
  <Show when="signed-out">
    <SignInButton mode="modal" asChild>
      <button class="cursor-pointer px-1 py-1 text-[var(--ink)] underline-offset-4 hover:underline">Sign in</button>
    </SignInButton>
    <SignUpButton mode="modal" asChild>
      <button class="cursor-pointer border border-[var(--ink)] bg-[var(--paper)] px-3 py-1 text-[var(--ink)] hover:bg-[var(--ink)] hover:text-[var(--paper)]">Sign up</button>
    </SignUpButton>
  </Show>
  <Show when="signed-in">
    <UserButton />
  </Show>
</div>
