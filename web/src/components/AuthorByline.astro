---
// Author byline for the agent guides and blog posts (lib/authors.ts). The default line sits under
// a page title; the full card closes the page with a short bio. Both link to the author's profile.
// Plain <img>: the Cloudflare adapter uses imageService 'passthrough', so there is no /_image endpoint.
import { AUTHOR } from '../lib/authors';

interface Props {
  variant?: 'line' | 'card';
  /** ISO date shown in the line, e.g. the post's updated date. */
  date?: string;
  dateLabel?: string;
}
const { variant = 'line', date, dateLabel = 'Updated' } = Astro.props;
const longDate = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
{variant === 'line' ? (
  <p class="author-line">
    <a class="author-photo-link" href={AUTHOR.url} rel="author" aria-hidden="true" tabindex="-1">
      <img class="author-photo" src={AUTHOR.photo.src} alt="" width="36" height="36" decoding="async">
    </a>
    <span class="author-text">
      <span>By <a href={AUTHOR.url} rel="author">{AUTHOR.name}</a></span>
      <span class="author-sub">{AUTHOR.role}{date && <Fragment>{` · ${dateLabel} `}<time datetime={date}>{longDate(date)}</time></Fragment>}</span>
    </span>
  </p>
) : (
  <aside class="author-card" aria-label="About the author">
    <a href={AUTHOR.url} rel="author" aria-hidden="true" tabindex="-1">
      <img class="author-photo author-photo-lg" src={AUTHOR.photo.src} alt="" width="64" height="64" loading="lazy" decoding="async">
    </a>
    <div>
      <p class="author-card-kicker">Written by</p>
      <p class="author-card-name"><a href={AUTHOR.url} rel="author">{AUTHOR.name}</a></p>
      <p class="author-card-role">{AUTHOR.role}</p>
      <p class="author-card-bio">{AUTHOR.bio}</p>
      <p class="author-card-links"><a href={AUTHOR.url} rel="author">Profile and writing <span aria-hidden="true">↗</span></a><a href={AUTHOR.x} target="_blank" rel="noopener">@sayanchowdhuryai on X <span aria-hidden="true">↗</span></a></p>
    </div>
  </aside>
)}

<style>
  .author-line { display: flex; align-items: center; gap: 10px; margin: 18px 0 0; font-size: 14px; line-height: 1.35; }
  .author-photo-link { display: inline-flex; flex: none; }
  .author-photo { width: 36px; height: 36px; border-radius: 999px; object-fit: cover; display: block; box-shadow: 0 0 0 1px var(--k-line); }
  .author-photo-lg { width: 64px; height: 64px; }
  .author-text { display: grid; gap: 2px; }
  .author-text a { color: var(--k-ink); font-weight: 600; text-decoration: none; }
  .author-text a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .author-sub { font-size: 12.5px; color: var(--k-muted); }

  .author-card { display: flex; gap: 16px; align-items: flex-start; margin: 40px 0 0; padding: 20px; border: 1px solid var(--k-line); border-radius: 16px; max-width: 820px; }
  .author-card p { margin: 0; }
  .author-card-kicker { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--k-muted); }
  .author-card-name { font-size: 18px; font-weight: 600; margin-top: 2px !important; }
  .author-card-name a { color: var(--k-ink); text-decoration: none; }
  .author-card-name a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .author-card-role { font-size: 13px; color: var(--k-muted); }
  .author-card-bio { font-size: 14.5px; line-height: 1.6; color: var(--k-soft); margin-top: 10px !important; }
  .author-card-links { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 10px !important; font-size: 13.5px; }
  .author-card-links a { color: var(--k-ink); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 520px) { .author-card { flex-direction: column; } }
</style>
