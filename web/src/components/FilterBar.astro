---
// Search, category, style and sort controls plus the grid/table toggle.
// The gallery script reads these by id (#search, #category, #style, #sort, #view-toggle).
// Options are built from the catalog the same way the script builds them.
interface Props {
  categories: string[];
  styles: string[];
}
const { categories, styles } = Astro.props;

const sorts = [
  { value: 'impressions', label: 'Impressions ↓' },
  { value: 'views', label: 'Plays ↓' },
  { value: 'bookmarks', label: 'Bookmarks ↓' },
  { value: 'likes', label: 'Likes ↓' },
  { value: 'date', label: 'Newest launches' },
  { value: 'oldest', label: 'Oldest launches' },
];
---
<div class="filter-bar">
  <label class="search-label"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><input id="search" type="search" placeholder="Search brands or videos…" aria-label="Search by brand name, video title, creator or style"></label>
  <label><span class="sr-only">Category</span><select id="category"><option value="all">All categories</option>{categories.map((category) => <option>{category}</option>)}</select></label>
  <label><span class="sr-only">Visual style</span><select id="style"><option value="all">All styles</option>{styles.map((style) => <option>{style}</option>)}</select></label>
  <label><span class="sr-only">Sort videos</span><select id="sort">{sorts.map((sort) => <option value={sort.value}>{sort.label}</option>)}</select></label>
  <button id="view-toggle" type="button" aria-label="Switch to table view" title="Switch to table view"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M3 14h18M9 4v16"/></svg></button>
</div>
