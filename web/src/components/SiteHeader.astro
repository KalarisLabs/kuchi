---
// Masthead: the Kuchi lockup ("Kuchi by Kalaris Labs"), the top navigation bar, and the theme toggle.
// Brand lockups are production assets from kalarislabs.com/brand.
import wordmarkBlack from '../assets/kalaris-wordmark-black.png';
import wordmarkWhite from '../assets/kalaris-wordmark-white.png';
import { KuchiPlayer } from './KuchiPlayer';
import CommandPalette from './CommandPalette.astro';
import { videos } from '../lib/catalog';
import { components } from '../lib/components-catalog';

interface Props {
  navHref?: string;
  navLabel?: string;
}
const { navHref, navLabel } = Astro.props;

const pathname = Astro.url.pathname;
const isComponents = pathname.startsWith('/components');
const isVideos = pathname.startsWith('/videos');
---
<header class="masthead site-header" data-site-header data-site-page={isComponents ? "components" : isVideos ? "launch-videos" : "home"}>
  <div class="brand">
    <a class="logo" href="/" aria-label="Kuchi by Kalaris Labs, home">
      <img class="logo-mark" src="/favicon.svg" width="24" height="24" alt="" aria-hidden="true">
      <span class="logo-name">Kuchi</span>
      <span class="logo-by" aria-hidden="true">by</span>
      <img class="logo-wordmark logo-wordmark-light" src={wordmarkBlack.src} width="1200" height="400" alt="" aria-hidden="true">
      <img class="logo-wordmark logo-wordmark-dark" src={wordmarkWhite.src} width="1200" height="400" alt="" aria-hidden="true">
    </a>
  </div>

  <nav class="site-nav" aria-label="Primary navigation">
    <a href="/videos" class:list={['site-nav-link', { active: isVideos }]} aria-current={isVideos ? 'page' : undefined}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5" width="15" height="14" rx="2.5"/><path d="m17.5 10 4-2.5v9l-4-2.5"/><path d="m8.5 9.5 4 2.5-4 2.5z" fill="currentColor" stroke="none"/></svg>
      <span class="site-nav-label">Videos</span>
      <span class="site-nav-badge" aria-label={`${videos.length} videos`}>{videos.length}</span>
    </a>
    <a href="/components" class:list={['site-nav-link', { active: isComponents }]} aria-current={isComponents ? 'page' : undefined}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="3.75"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="2"/><path d="M17.25 13.5v7.5M13.5 17.25H21"/></svg>
      <span class="site-nav-label">Components</span>
      <span class="site-nav-badge" aria-label={`${components.length} components`}>{components.length}</span>
    </a>
  </nav>

  <button class="site-search" type="button" data-cmdk-open aria-label="Search videos, components and pages" aria-haspopup="dialog" aria-controls="cmdk">
    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <span class="site-search-label">Search</span>
    <kbd class="site-search-key" data-cmdk-key aria-hidden="true">Ctrl K</kbd>
  </button>

  {navHref && navLabel && <nav class="meta" aria-label="Page navigation"><a href={navHref}>{navLabel}</a></nav>}

  <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Toggle theme">
    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
  </button>

  <KuchiPlayer client:load />
  <CommandPalette />
</header>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: 12px;
  }
  .site-nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 12px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--k-muted);
    text-decoration: none;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .site-nav-link svg { flex: none; }
  .site-nav-link:hover { color: var(--k-ink); background: var(--k-wash); text-decoration: none; }
  .site-nav-link:active { transform: scale(0.97); }
  .site-nav-link.active { color: var(--k-ink); }
  /* The current page: a short bar under the item, not a filled pill. */
  .site-nav-link.active::after {
    content: "";
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: -15px;
    height: 2px;
    border-radius: 2px;
    background: var(--k-ink);
  }
  .site-nav-badge {
    font-size: 11px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    padding: 1px 6px;
    border-radius: 6px;
    background: var(--k-wash);
    border: 1px solid var(--k-line);
    color: var(--k-muted);
    line-height: 1.4;
  }
  .site-nav-link.active .site-nav-badge { color: var(--k-ink); }
  .site-search {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    width: 220px;
    margin-left: auto;
    padding: 0 6px 0 11px;
    border: 1px solid var(--k-line);
    border-radius: 10px;
    background: var(--k-field);
    color: var(--k-muted);
    font: inherit;
    font-size: 13.5px;
    cursor: pointer;
    transition: border-color 150ms ease, color 150ms ease;
  }
  .site-search:hover { border-color: color-mix(in srgb, var(--k-ink) 28%, var(--k-line)); color: var(--k-ink); }
  .site-search:active { transform: scale(0.98); }
  .site-search-label { flex: 1; text-align: left; }
  .site-search-key {
    padding: 2px 6px;
    border: 1px solid var(--k-line);
    border-radius: 6px;
    background: var(--k-wash);
    font: 500 11px/1.3 var(--k-sans);
    color: var(--k-muted);
  }
  .masthead :global(.theme-toggle) { margin-left: 4px; }
  @media (max-width: 900px) {
    .site-search { width: auto; }
    .site-search-label { display: none; }
  }
  @media (max-width: 720px) {
    .site-nav { margin-left: 4px; }
    .site-nav-link { padding: 0 9px; gap: 6px; font-size: 13px; }
    .site-nav-badge, .site-search-key { display: none; }
    .site-nav-link.active::after { bottom: -13px; }
    .site-search { width: 36px; padding: 0; justify-content: center; }
  }
  @media (max-width: 520px) {
    .masthead { gap: 6px; }
    .masthead .logo .logo-by,
    .masthead .logo .logo-wordmark { display: none; }
    .site-nav-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .site-nav-link { padding: 0 10px; }
    .site-nav-link.active::after { left: 8px; right: 8px; }
  }
  @media (hover: none) {
    .site-search-key { display: none; }
  }
</style>

<script>
  // Likes and saves (lib/favorites.js): kept in this browser, synced on every page.
  import { initFavorites } from '../lib/favorites.js';
  initFavorites();
</script>

<script>
  // Toggle between light and dark, remember the choice, and follow the system setting
  // while the visitor has not chosen. The initial theme is set inline in BaseLayout.
  const KEY = 'kuchi-theme';
  const root = document.documentElement;
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  const sync = () => {
    const dark = root.dataset.theme === 'dark';
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      button.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
      button.setAttribute('aria-pressed', String(dark));
    }
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#121212' : '#ffffff');
  };
  const set = (theme: string) => { root.dataset.theme = theme; sync(); };
  for (const button of document.querySelectorAll('[data-theme-toggle]')) {
    button.addEventListener('click', (event) => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      try { localStorage.setItem(KEY, next); } catch {}
      // A pointer click crossfades the page between themes (view transition, timed in
      // styles/polish.css). Keyboard toggles and reduced motion switch at once.
      const fade = event.detail > 0 && 'startViewTransition' in document
        && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (fade) document.startViewTransition(() => set(next));
      else set(next);
    });
  }
  system.addEventListener('change', (e) => {
    let saved = null;
    try { saved = localStorage.getItem(KEY); } catch {}
    if (!saved) set(e.matches ? 'dark' : 'light');
  });
  sync();
</script>
