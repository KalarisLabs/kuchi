---
// Masthead: the Kuchi lockup ("Kuchi by Kalaris Labs") and the theme toggle. The Kalaris
// Labs wordmarks are the production files from kalarislabs.com/brand, self-hosted as the
// brand page asks: black for light backgrounds, white for dark; CSS shows the one that
// matches the theme. Never rebuild the wordmark in live text. The single nav link differs
// per page (collection anchor vs. back to Kuchi).
import wordmarkBlack from '../assets/kalaris-wordmark-black.png';
import wordmarkWhite from '../assets/kalaris-wordmark-white.png';

// The gallery page passes no nav link (the "Collection" link was removed on the owner's
// instruction, 2026-11-14); the legal pages pass the link back to Kuchi.
interface Props {
  navHref?: string;
  navLabel?: string;
}
const { navHref, navLabel } = Astro.props;
---
<header class="masthead site-header" data-site-header data-site-page="launch-videos">
  <div class="brand">
    <a class="logo" href="/" aria-label="Kuchi by Kalaris Labs, home">
      <img class="logo-mark" src="/favicon.svg" width="24" height="24" alt="" aria-hidden="true">
      <span class="logo-name">Kuchi</span>
      <span class="logo-by" aria-hidden="true">by</span>
      <img class="logo-wordmark logo-wordmark-light" src={wordmarkBlack.src} width="1200" height="400" alt="" aria-hidden="true">
      <img class="logo-wordmark logo-wordmark-dark" src={wordmarkWhite.src} width="1200" height="400" alt="" aria-hidden="true">
    </a>
  </div>
  {navHref && navLabel && <nav class="meta" aria-label="Page navigation"><a href={navHref}>{navLabel}</a></nav>}
  <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Toggle theme">
    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
  </button>
</header>

<script>
  // Toggle between light and dark, remember the choice, and follow the system setting
  // while the visitor has not chosen. The initial theme is set inline in BaseLayout.
  const KEY = 'kuchi-theme';
  const root = document.documentElement;
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  const sync = () => {
    const dark = root.dataset.theme === 'dark';
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      button.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
      button.setAttribute('aria-pressed', String(dark));
    }
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#121212' : '#ffffff');
  };
  const set = (theme: string) => { root.dataset.theme = theme; sync(); };
  for (const button of document.querySelectorAll('[data-theme-toggle]')) {
    button.addEventListener('click', (event) => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      try { localStorage.setItem(KEY, next); } catch {}
      // A pointer click crossfades the page between themes (view transition, timed in
      // styles/polish.css). Keyboard toggles and reduced motion switch at once.
      const fade = event.detail > 0 && 'startViewTransition' in document
        && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (fade) document.startViewTransition(() => set(next));
      else set(next);
    });
  }
  system.addEventListener('change', (e) => {
    let saved = null;
    try { saved = localStorage.getItem(KEY); } catch {}
    if (!saved) set(e.matches ? 'dark' : 'light');
  });
  sync();
</script>
