---
// Document shell shared by every page: head, favicons, link previews (Open Graph and
// Twitter cards), global styles, smooth scroll.
import '../styles/global.css';
import '../styles/polish.css';
import ogImage from '../assets/og-image.png';

interface Props {
  title: string;
  description?: string;
}
const DEFAULT_DESCRIPTION = 'Launch-video references, updated daily. Watch launch videos and connect your agent to the latest references with MCP.';
const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
// Absolute URLs (astro.config.mjs `site`). The canonical drops ".html" so /privacy and
// /privacy.html (both served, see build.format) count as one page.
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site).href;
const image = new URL(ogImage.src, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#ffffff">
    <!-- Theme before first paint: the saved choice (SiteHeader toggle), else the system setting. -->
    <script is:inline>(function(){var t=null;try{t=localStorage.getItem("kuchi-theme")}catch(e){}if(t!=="light"&&t!=="dark")t=matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";document.documentElement.dataset.theme=t;})();</script>
    <meta name="description" content={description}>
    <title>{title}</title>
    <link rel="canonical" href={canonical}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Kuchi by Kalaris Labs">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={image}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Kuchi: AI clonable viral launch videos">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={image}>
    <link rel="sitemap" href="/sitemap.xml">
    <link rel="icon" href="/favicon-32.png?v=popcorn-1" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon.svg?v=popcorn-1" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/favicon-180.png?v=popcorn-1">
  </head>
  <body>
    <slot />
    <script>
      import { initSmoothScroll } from '../scripts/motion';
      import '../scripts/polish';
      initSmoothScroll();
    </script>
  </body>
</html>
