---
// Privacy, terms, legal notice, analytics preferences and support share one text layout.
// Every page using it is prerendered static HTML: all content is in the markup, none of it
// is written by JavaScript. Optional extras for the long legal pages:
//   description  meta and link-preview description
//   jsonLd       structured data (WebPage, AboutPage, ...), emitted by BaseLayout
//   toc          "On this page" links to the section headings (each h2 carries an id)
//   slot="intro" heading and lead, rendered above the table of contents
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  toc?: { id: string; label: string }[];
}
const { title, description, jsonLd, toc } = Astro.props;
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <SiteHeader navHref="/" navLabel="Kuchi ↗" />
  <main class="document"><article class="legal-copy">
    <slot name="intro" />
    {toc && toc.length > 0 && (
      <nav class="legal-toc" aria-labelledby="legal-toc-title">
        <h2 id="legal-toc-title" class="legal-toc-title">On this page</h2>
        <ol>{toc.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ol>
      </nav>
    )}
    <slot />
  </article></main>
  <SiteFooter />
</BaseLayout>

<style>
  .legal-copy { max-width: 760px; margin: 48px auto 80px; line-height: 1.8; }
  .legal-copy :global(h1) { font-size: clamp(30px, 5vw, 48px); line-height: 1.2; margin: 0 0 16px; }
  .legal-copy :global(h2) { font-size: 20px; margin: 28px 0 8px; scroll-margin-top: 96px; }
  .legal-copy :global(h3) { font-size: 16px; margin: 20px 0 6px; scroll-margin-top: 96px; }
  .legal-copy :global(p) { margin: 0 0 16px; }
  .legal-copy :global(ul), .legal-copy :global(ol) { margin: 0 0 16px; padding-left: 22px; }
  .legal-copy :global(li) { margin: 0 0 6px; }
  .legal-copy :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .legal-copy :global(.legal-meta) { color: var(--k-muted); font-size: 14px; }
  .legal-copy :global(.legal-table) { width: 100%; overflow-x: auto; margin: 0 0 20px; border: 1px solid var(--k-line); border-radius: 10px; }
  .legal-copy :global(table) { width: 100%; border-collapse: collapse; font-size: 14px; line-height: 1.55; }
  .legal-copy :global(th), .legal-copy :global(td) { text-align: left; vertical-align: top; padding: 10px 12px; border-bottom: 1px solid var(--k-line); }
  .legal-copy :global(tr:last-child td) { border-bottom: 0; }
  .legal-copy :global(th) { font-weight: 600; background: var(--k-wash); }
  .legal-copy :global(.legal-note) { padding: 14px 16px; border: 1px solid var(--k-line); border-radius: 10px; background: var(--k-wash); margin: 0 0 20px; }
  .legal-toc { margin: 8px 0 32px; padding: 16px 20px; border: 1px solid var(--k-line); border-radius: 10px; }
  .legal-toc .legal-toc-title { font-size: 14px; margin: 0 0 6px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--k-muted); }
  .legal-toc ol { margin: 0; padding-left: 22px; columns: 2 240px; column-gap: 32px; }
  .legal-toc li { margin: 0 0 4px; break-inside: avoid; }
</style>
