---
// Privacy, terms and support share one text layout.
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<BaseLayout title={title}>
  <SiteHeader navHref="/" navLabel="Kuchi ↗" />
  <main class="document"><article class="legal-copy"><slot /></article></main>
  <SiteFooter />
</BaseLayout>

<style>
  .legal-copy { max-width: 760px; margin: 48px auto 80px; line-height: 1.8; }
  .legal-copy :global(h1) { font-size: clamp(30px, 5vw, 48px); line-height: 1.2; margin: 0 0 16px; }
  .legal-copy :global(h2) { font-size: 20px; margin: 28px 0 8px; }
  .legal-copy :global(p) { margin: 0 0 16px; }
  .legal-copy :global(a) { text-decoration: underline; text-underline-offset: 3px; }
</style>
