---
// /components: copy-paste video components (Remotion). Pressing a card plays its clip in the
// site player (components/KuchiPlayer.tsx) with the install command underneath.
// Two-column documentation layout with sidebar navigation.
import BaseLayout from '../layouts/BaseLayout.astro';
import SkipLink from '../components/SkipLink.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Toast from '../components/Toast.astro';
import ComponentsSidebar from '../components/ComponentsSidebar';
import { COMPONENTS_SETUP_PROMPT } from '../lib/component-prompts';
import { MCP_URL, PLUGIN_COMMAND, SKILL_COMMAND } from '../lib/harnesses';
import { components, categories, categoryLabels, installCommand, posterUrl, videoUrl, SITE } from '../lib/components-catalog';
import { favButtonsHTML } from '../lib/favorites.js';

export const prerender = true;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Video components',
    url: `${SITE}/components`,
    description: `${components.length} copy-paste Remotion video components for launch videos, installable with the shadcn CLI.`,
    isPartOf: { '@type': 'WebSite', name: 'Kuchi', url: `${SITE}/` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: components.length,
      itemListElement: components.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `${SITE}/components/${item.name}`,
        name: item.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Kuchi', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Video components', item: `${SITE}/components` },
    ],
  },
];


// The sidebar directory: every category with its components, in page order.
const sidebarGroups = categories
  .map((key) => ({
    key,
    label: categoryLabels[key] || key,
    items: components.filter((item) => item.category === key).map(({ name, title }) => ({ name, title })),
  }))
  .filter((group) => group.items.length > 0);

// Category shortcuts at the top of the sidebar box: an icon each (24px grid, stroke icons).
const ICONS: Record<string, string> = {
  templates: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
  text: '<path d="M4 7V4h16v3M9 20h6M12 4v16"/>',
  scenes: '<path d="M4 11v8a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-8H4Z"/><path d="m4 11-.9-3.2a1 1 0 0 1 .7-1.2l13.5-3.6a1 1 0 0 1 1.2.7L19.4 7 4 11Z"/><path d="m8.5 5.6 3 3.4M13.3 4.3l3 3.4"/>',
  screens: '<rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>',
  'ai-chat': '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/>',
  code: '<path d="m4 17 6-6-6-6M12 19h8"/>',
  captions: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 15h4M15 15h2M7 11h2M13 11h4"/>',
  transitions: '<path d="M3 12h18M15 6l6 6-6 6M9 6 3 12l6 6"/>',
};
const iconCats = Object.keys(ICONS).filter((key) => categories.includes(key));

// The hero's agent setup tabs. Every command is a real install path (see lib/harnesses.ts).
// The first tab is one prompt that sets up any agent (owner, 2026-11-19).
const agentSetups: { id: string; label: string; note: string; prompt?: string; commands: { prompt: string; code: string; copied: string }[] }[] = [
  {
    id: 'any',
    label: 'Any agent',
    note: 'One prompt for Claude Code, Codex, Cursor, Gemini CLI, OpenCode or any agent that can run commands: it connects the MCP server, adds the registry and installs on request.',
    prompt: COMPONENTS_SETUP_PROMPT,
    commands: [],
  },
  {
    id: 'claude-code',
    label: 'Claude Code',
    note: 'One plugin adds the Kuchi MCP server and the Kuchi skill together.',
    commands: [{ prompt: '>', code: PLUGIN_COMMAND, copied: 'Plugin command copied' }],
  },
  {
    id: 'codex',
    label: 'Codex',
    note: 'Add the MCP server, then the skill so Codex knows how to use the components.',
    commands: [
      { prompt: '$', code: `codex mcp add kuchi --url ${MCP_URL}`, copied: 'MCP command copied' },
      { prompt: '$', code: SKILL_COMMAND, copied: 'Skill command copied' },
    ],
  },
  {
    id: 'skill',
    label: 'Agent skill',
    note: 'Install the Kuchi skill into your project for Cursor, Gemini CLI and other agents that read skills.',
    commands: [{ prompt: '$', code: SKILL_COMMAND, copied: 'Skill command copied' }],
  },
  {
    id: 'mcp',
    label: 'Any MCP client',
    note: 'Paste this server URL into Cursor, VS Code, Claude, ChatGPT or any MCP client. No sign-in, no API key.',
    commands: [{ prompt: 'URL', code: MCP_URL, copied: 'MCP server URL copied' }],
  },
];
---
<BaseLayout
  title="Video components · Kuchi"
  description={`${components.length} copy-paste Remotion video components for launch videos: kinetic type, scenes, phone and UI screens, AI chats, captions and transitions. Install with the shadcn CLI.`}
  jsonLd={jsonLd}
>
  <SkipLink href="#cmp-title" label="Skip to components" />
  <SiteHeader />

  <div class="cmp-page-container">
    <div class="cmp-layout">
      <!-- Left Sidebar Navigation -->
      <aside class="cmp-sidebar" id="cmp-sidebar" aria-label="Component directory">
        <div class="cmp-box">
          <div class="cmp-box-head">
            <span class="cmp-box-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></span>
            <span class="cmp-box-title">Components</span>
            <span class="cmp-box-count">{components.length}</span>
          </div>

          <div class="cmp-box-cats" aria-label="Jump to a category">
            {iconCats.map((key) => (
              <a class="cmp-box-cat" href={`#cat-${key}`} title={categoryLabels[key]} aria-label={categoryLabels[key]}>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[key]} />
              </a>
            ))}
          </div>

          <label class="cmp-sidebar-search-label">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
            <input type="search" id="cmp-sidebar-search" placeholder="Filter…" aria-label="Filter components" />
          </label>

          <div class="cmp-sidebar-nav">
            <p class="cmp-box-section">Get started</p>
            <ul class="cmp-box-links">
              <li><a href="#cmp-title">Introduction</a></li>
              <li><a href="#setup">Installation</a></li>
              <li><a href="/blog/remotion-components-for-ai-agents">MCP server</a></li>
              <li><button type="button" data-sidebar-saved><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-6-4.5L6 21V3Z"/></svg>Saved</button></li>
            </ul>
            <nav aria-label="Components navigation">
              <ComponentsSidebar client:load groups={sidebarGroups} />
            </nav>
          </div>
        </div>
      </aside>

      <!-- Main Content Area -->
      <main class="cmp-main" id="cmp-main">
        <div class="cmp-hero">
          <div class="cmp-hero-badge">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7V4h16v3M9 20h6M12 4v16"/></svg>
            <span>Remotion & Video Components Registry</span>
          </div>
          <h1 id="cmp-title">Video components</h1>
          <p class="cmp-hero-desc">
            Production-ready Remotion motion components for the shots a viral launch video is made of.
            Open-source Remotion components (MIT).
            Connect your agent once and it can browse every component, read its source and drop it into your project.
          </p>

          <!-- Agent setup: the Kuchi MCP server (kuchi_list_components, kuchi_get_component) plus
               the Kuchi skill that teaches the workflow. Same commands as the /agents guides. -->
          <div class="cmp-agent" id="setup" data-agent-tabs>
            <div class="cmp-agent-tabs" role="tablist" aria-label="Connect your agent">
              {agentSetups.map((setup, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`cmp-agent-tab-${setup.id}`}
                  aria-controls={`cmp-agent-panel-${setup.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  class="cmp-agent-tab"
                >
                  {setup.label}
                </button>
              ))}
            </div>
            {agentSetups.map((setup, i) => (
              <div
                class="cmp-agent-panel"
                role="tabpanel"
                id={`cmp-agent-panel-${setup.id}`}
                aria-labelledby={`cmp-agent-tab-${setup.id}`}
                hidden={i !== 0}
              >
                <p class="cmp-agent-note">{setup.note}</p>
                {setup.prompt && (
                  <div class="cmp-prompt">
                    <pre class="cmp-prompt-text" tabindex="0">{setup.prompt}</pre>
                    <button type="button" class="pill cmp-prompt-copy" data-copy-setup-prompt>Copy setup prompt</button>
                  </div>
                )}
                {setup.commands.map((cmd) => (
                  <div class="cmp-hero-cli">
                    <div class="cmp-cli-box">
                      <span class="cmp-cli-prompt">{cmd.prompt}</span>
                      <code class="cmp-cli-text">{cmd.code}</code>
                    </div>
                    <button type="button" class="pill pill-secondary cmp-cli-copy" data-copy-cmd={cmd.code} data-copy-label={cmd.copied}>
                      Copy
                    </button>
                  </div>
                ))}
              </div>
            ))}
            <p class="cmp-agent-next">
              Then ask: <em>“Find a Kuchi component for a kinetic headline and add it to my Remotion project.”</em>{' '}
              Your agent finds it with <code>kuchi_list_components</code> and reads the source with <code>kuchi_get_component</code>.{' '}
              <a href="/agents">Guides for every agent →</a>
            </p>
          </div>
        </div>

        <!-- Components Browser & Filters -->
        <section class="cmp-browser" aria-labelledby="browser-heading">
          <div class="cmp-section-header">
            <h2 id="browser-heading">Component Directory</h2>
            <p>Browse kinetic typography, device mockups, chat streams, scene transitions, and captions.</p>
          </div>

          <div class="cmp-tools">
            <label class="search-label cmp-search-wrap">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
              <input id="cmp-search" type="search" placeholder={`Search ${components.length} components by keyword or style…`} aria-label="Search components" />
            </label>

            <div class="cmp-chips" role="group" aria-label="Filter by category">
              <button type="button" class="cmp-chip" data-cat="all" aria-pressed="true">All</button>
              {categories.map((key) => (
                <button type="button" class="cmp-chip" data-cat={key} aria-pressed="false">
                  {categoryLabels[key] || key}
                </button>
              ))}
              <button type="button" class="cmp-chip cmp-chip-mine" data-cat="saved" aria-pressed="false">Saved <span class="mine-count" data-fav-count="saved:component"></span></button>
              <button type="button" class="cmp-chip cmp-chip-mine" data-cat="liked" aria-pressed="false">Liked <span class="mine-count" data-fav-count="liked:component"></span></button>
            </div>

            <span id="cmp-count" class="cmp-count" role="status" aria-live="polite">{components.length} components</span>
          </div>

          <!-- Grouped by Category -->
          <div class="cmp-categories-container">
            {categories.map((catKey) => {
              const catItems = components.filter((item) => item.category === catKey);
              if (!catItems.length) return null;
              return (
                <section class="cmp-cat-section" id={`cat-${catKey}`} data-cat-section={catKey}>
                  <div class="cmp-cat-heading">
                    <h3>{categoryLabels[catKey] || catKey}</h3>
                    <span class="cmp-cat-count">{catItems.length} items</span>
                  </div>

                  <ul class="cmp-grid">
                    {catItems.map((item) => (
                      <li
                        class="cmp-card"
                        id={`cmp-${item.name}`}
                        data-name={item.name}
                        data-cat={item.category}
                        data-search={`${item.title} ${item.description} ${item.category}`.toLowerCase()}
                      >
                        <div class="cmp-card-inner">
                          <button
                            type="button"
                            class="cmp-open"
                            data-play={item.name}
                            data-src={videoUrl(item.name)}
                            aria-label={`Play ${item.title}`}
                          >
                            <span class="cmp-media">
                              <img
                                src={posterUrl(item.name)}
                                alt=""
                                loading="lazy"
                                decoding="async"
                                width="640"
                                height="360"
                                data-poster
                              />
                              <video
                                src={videoUrl(item.name)}
                                muted
                                loop
                                playsinline
                                preload="none"
                                data-preview
                              ></video>
                              <span class="cmp-media-overlay">
                                <span class="cmp-preview-pill">Play clip</span>
                              </span>
                            </span>
                          </button>

                          <div class="cmp-card-bottom">
                            <div class="cmp-meta">
                              <a class="cmp-title" href={`/components/${item.name}`}>{item.title}</a>
                              <span class="cmp-cat">{categoryLabels[item.category] || item.category}</span>
                            </div>

                            <p class="cmp-desc-snippet">{item.description}</p>

                            <div class="cmp-card-actions">
                              <div class="cmp-actions-left">
                              <button
                                type="button"
                                class="cmp-quick-install"
                                data-copy-cmd={installCommand(item.name)}
                                title="Copy install CLI command"
                              >
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                                <span>Copy CLI</span>
                              </button>
                              <Fragment set:html={favButtonsHTML('component', item.name, item.title)} />
                              </div>

                              <button
                                type="button"
                                class="cmp-details-btn"
                                data-open={item.name}
                              >
                                View Code ↗
                              </button>
                            </div>
                          </div>
                        </div>
                      </li>
                    ))}
                  </ul>
                </section>
              );
            })}
          </div>

          <div id="cmp-empty" class="empty" hidden>
            <p>No matching video components found.</p>
            <button type="button" id="cmp-reset">Reset filters ↗</button>
          </div>
        </section>
      </main>
    </div>
  </div>

  <!-- Source Code & Install Dialog -->
  <dialog id="cmp-dialog" class="cmp-dialog" aria-labelledby="cmp-d-title">
    <div class="cmp-d-bar">
      <div class="cmp-d-title-group">
        <h2 id="cmp-d-title"></h2>
        <span class="cmp-d-badge">shadcn compatible</span>
      </div>
      <button type="button" class="pill pill-secondary cmp-d-play" id="cmp-d-play">Play clip</button>
      <button type="button" class="cmp-d-close" id="cmp-d-close" aria-label="Close dialog">✕</button>
    </div>
    <div class="cmp-d-body" data-lenis-prevent>
      <p id="cmp-d-desc" class="cmp-d-desc"></p>
      
      <div class="cmp-install-box">
        <div class="cmp-install-label">Install command (CLI):</div>
        <div class="cmp-install">
          <code id="cmp-d-cmd"></code>
          <button type="button" class="pill pill-secondary" id="cmp-copy-cmd">Copy command</button>
        </div>
      </div>

      <p class="cmp-d-note" id="cmp-d-deps"></p>
      <div class="cmp-usage-tip">
        <strong>Remotion tip:</strong> If a frame renders black, the component is drawing on a transparent layer: put a background behind it in your composition (e.g. <code>&lt;AbsoluteFill style=&#123;&#123; background: "#faf9f6" &#125;&#125;&gt;&lt;Component /&gt;&lt;/AbsoluteFill&gt;</code>).
      </div>

      <!-- The source, in the code-block UI (SourceCode), mounted when the dialog opens. -->
      <div id="cmp-d-src" class="cmp-d-src"><p class="cmp-d-src-status">Loading…</p></div>
    </div>
  </dialog>

  <Toast />
  <SiteFooter />

  <script>
    import '../scripts/components-page.ts';
  </script>
</BaseLayout>

<style>
  /* Layout: 2 columns with fixed/sticky sidebar */
  /* Full-bleed docs layout: the sidebar sits on the left edge and the grid uses the rest. */
  .cmp-page-container {
    width: 100%;
    margin: 0;
    padding: 0 clamp(16px, 2.2vw, 36px) 0 0;
  }

  .cmp-layout {
    display: flex;
    gap: clamp(24px, 2.6vw, 44px);
    position: relative;
    align-items: flex-start;
  }

  /* Sidebar: a floating box (owner, 2026-11-19, after a reference): header with the count,
     category shortcuts, the filter, Get started links, then the directory, which scrolls on
     its own inside the box. */
  .cmp-sidebar {
    width: 268px;
    flex-shrink: 0;
    position: sticky;
    top: 76px;
    height: calc(100dvh - 92px);
    margin: 20px 0 16px clamp(12px, 1.6vw, 24px);
  }
  .cmp-box {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 14px 12px 0;
    border: 1px solid var(--k-line);
    border-radius: 16px;
    background: color-mix(in srgb, var(--k-wash) 55%, var(--k-paper));
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 12px 32px -18px rgb(0 0 0 / 0.25);
    overflow: hidden;
  }
  .cmp-box-head { display: flex; align-items: center; gap: 8px; padding: 0 2px; }
  .cmp-box-icon {
    display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px;
    background: var(--k-paper); border: 1px solid var(--k-line); color: var(--k-ink);
  }
  .cmp-box-title { font-size: 14px; font-weight: 600; color: var(--k-ink); }
  .cmp-box-count {
    margin-left: auto; padding: 1px 7px; border-radius: 999px; font-size: 11.5px; font-variant-numeric: tabular-nums;
    color: var(--k-muted); border: 1px solid var(--k-line); background: var(--k-paper);
  }
  .cmp-box-cats { display: flex; justify-content: space-between; gap: 4px; padding-bottom: 12px; border-bottom: 1px solid var(--k-line); }
  .cmp-box-cat {
    display: grid; place-items: center; width: 27px; height: 27px; border-radius: 7px;
    color: var(--k-muted); text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .cmp-box-cat:hover { background: var(--k-paper); color: var(--k-ink); text-decoration: none; }
  .cmp-box-cat:focus-visible { outline: 2px solid var(--k-ink); outline-offset: 1px; }
  .cmp-box-section {
    margin: 4px 0 6px; font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--k-muted);
  }
  .cmp-box-links { list-style: none; margin: 0 0 18px; padding: 0; display: grid; gap: 1px; }
  .cmp-box-links a, .cmp-box-links button {
    display: flex; align-items: center; gap: 7px; width: 100%; padding: 5px 8px; border: 0; border-radius: 7px;
    background: none; font: inherit; font-size: 13px; color: var(--k-ink); text-align: left; text-decoration: none; cursor: pointer;
    transition: background-color 150ms ease;
  }
  .cmp-box-links a:hover, .cmp-box-links button:hover { background: var(--k-paper); text-decoration: none; }
  .cmp-box-links button svg { color: var(--k-muted); }

  .cmp-sidebar-search-label {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--k-paper);
    border: 1px solid var(--k-line);
    border-radius: 9px;
    padding: 7px 10px;
    color: var(--k-muted);
    transition: border-color 140ms ease, box-shadow 140ms ease;
  }
  .cmp-sidebar-search-label:focus-within {
    border-color: var(--k-accent, var(--k-ink));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--k-accent, var(--k-ink)) 22%, transparent);
    color: var(--k-ink);
  }
  .cmp-sidebar-search-label input {
    border: none;
    background: transparent;
    font-size: 13px;
    color: var(--k-ink);
    outline: none;
    width: 100%;
  }
  /* Everything under the filter scrolls inside the box. */
  .cmp-sidebar-nav {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    margin: 0 -12px;
    padding: 0 12px 32px;
    scrollbar-width: thin;
  }

  /* The setup prompt (first hero tab), set in Geist Mono like every prompt preview. */
  .cmp-prompt { display: grid; gap: 10px; max-width: 720px; }
  .cmp-prompt-text {
    margin: 0; padding: 14px 16px; border-radius: 12px;
    border: 1px solid var(--k-line); background: var(--k-wash);
    font-family: var(--font-prompt); font-size: 13.5px; line-height: 1.65; color: var(--k-ink);
    white-space: pre-wrap; overflow-wrap: anywhere;
  }
  .cmp-prompt-copy { justify-self: start; }

  /* The list itself is ComponentsSidebar (bounce-sidebar): React renders it, so these
     rules reach in with :global. The active row is the one the bouncing dot sits on. */
  .cmp-sidebar-nav :global([data-slot='bounce-sidebar']) {
    list-style: none;
    margin: 0;
  }
  .cmp-sidebar-nav :global(.cmp-sidebar-link) {
    font-size: 13px;
    line-height: 1.35;
    color: var(--k-muted);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .cmp-sidebar-nav :global(.cmp-sidebar-link:hover) {
    color: var(--k-ink);
    text-decoration: none;
  }
  .cmp-sidebar-nav :global(.cmp-sidebar-link[data-active='true']) {
    color: var(--k-ink);
    font-weight: 600;
  }
  .cmp-sidebar-nav :global([data-slot='bounce-sidebar-heading']) {
    padding-top: 22px;
  }
  .cmp-sidebar-nav :global([data-slot='bounce-sidebar-heading']:first-of-type) {
    padding-top: 0;
  }

  /* Main Content */
  .cmp-main {
    flex: 1;
    min-width: 0;
    padding: 36px 0 96px;
  }

  /* Hero */
  .cmp-hero {
    margin-bottom: 56px;
  }

  .cmp-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--k-wash);
    border: 1px solid var(--k-line);
    font-size: 12px;
    font-weight: 500;
    color: var(--k-muted);
    margin-bottom: 14px;
  }

