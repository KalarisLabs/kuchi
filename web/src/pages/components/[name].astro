---
// /components/<name>: one indexable page per video component, with its preview clip, install
// command, dependencies, related components and source, plus schema.org data for search.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkipLink from '../../components/SkipLink.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Toast from '../../components/Toast.astro';
import SourceCode from '../../components/SourceCode';
import { favButtonsHTML } from '../../lib/favorites.js';
import {
  components,
  categoryLabels,
  installCommand,
  posterUrl,
  videoUrl,
  pageUrl,
  SITE,
  type RegistryItem,
} from '../../lib/components-catalog';
import { componentPrompt } from '../../lib/component-prompts';

export const prerender = true;

export function getStaticPaths() {
  return components.map((item) => ({ params: { name: item.name }, props: { item } }));
}

const { item } = Astro.props as { item: RegistryItem };

const sources = import.meta.glob('../../registry/files/**/*', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;
// The licence notice travels with the installed copy (/r/<name>.json); the page shows the code
// without that first line.
const LICENCE = /^\/\*! Portions Copyright[^\n]*\*\/\n/;
const files = item.files.map((file) => ({
  path: file.target,
  code: (sources[`../../registry/${file.vendored}`] ?? '').replace(LICENCE, ''),
}));

const category = categoryLabels[item.category] || item.category;
const cmd = installCommand(item.name);
const agentPrompt = componentPrompt(item.name, item.title);
const related = components.filter((c) => c.category === item.category && c.name !== item.name).slice(0, 8);
const npmDeps = item.dependencies;
const kuchiDeps = item.registryDependencies;

const firstSentence = item.description.split(/(?<=\.)\s/)[0];
const metaDescription = (() => {
  const base = `${item.title}: ${item.description}`;
  return base.length > 158 ? `${base.slice(0, 155).replace(/\s+\S*$/, '')}…` : base;
})();
const url = pageUrl(item.name);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: `${item.title} (Remotion component)`,
    description: item.description,
    url,
    programmingLanguage: ['TypeScript', 'React'],
    runtimePlatform: 'Remotion',
    license: 'https://opensource.org/licenses/MIT',
    codeSampleType: 'full solution',
    isAccessibleForFree: true,
    image: posterUrl(item.name),
    publisher: { '@type': 'Organization', name: 'Kalaris Labs', url: SITE },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: `${item.title}: Remotion video component preview`,
    description: firstSentence,
    thumbnailUrl: posterUrl(item.name),
    contentUrl: videoUrl(item.name),
    uploadDate: '2026-11-17',
    embedUrl: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Kuchi', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Video components', item: `${SITE}/components` },
      { '@type': 'ListItem', position: 3, name: item.title, item: url },
    ],
  },
];
---
<BaseLayout
  title={`${item.title}: Remotion video component · Kuchi`}
  description={metaDescription}
  ogType="article"
  jsonLd={jsonLd}
>
  <SkipLink href="#cd-title" label="Skip to component" />
  <SiteHeader />

  <main class="cd-page" id="cd-main">
    <nav class="cd-crumbs" aria-label="Breadcrumb">
      <a href="/components">Video components</a>
      <span aria-hidden="true">/</span>
      <a href={`/components#cat-${item.category}`}>{category}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{item.title}</span>
    </nav>

    <header class="cd-head">
      <span class="cd-cat">{category}</span>
      <h1 id="cd-title">{item.title}</h1>
      <p class="cd-desc">{item.description}</p>
      <Fragment set:html={favButtonsHTML('component', item.name, item.title, 'fav-labeled')} />
    </header>

    <div class="cd-grid">
      <figure class="cd-player">
        <div class="cd-stage">
          <video
            src={videoUrl(item.name)}
            poster={posterUrl(item.name)}
            controls
            muted
            loop
            playsinline
            preload="none"
            width="640"
            height="360"
          ></video>
        </div>
        <figcaption>{item.title} preview, rendered with Remotion.</figcaption>
      </figure>

      <aside class="cd-side">
        <section aria-labelledby="cd-install">
          <h2 id="cd-install">Install</h2>
          <p>One command copies the source and everything it depends on into your Remotion project.</p>
          <div class="cd-cmd">
            <code>{cmd}</code>
            <button type="button" class="pill pill-secondary" data-copy-cmd={cmd}>Copy</button>
          </div>
        </section>

        <section aria-labelledby="cd-agents">
          <h2 id="cd-agents">Install with your agent</h2>
          <p>Paste this into Claude Code, Codex, Cursor or any agent that can run commands.</p>
          <pre class="cd-prompt" tabindex="0">{agentPrompt}</pre>
          <button type="button" class="pill pill-secondary cd-prompt-copy" data-copy-cmd={agentPrompt} data-copied="Prompt copied. Paste it into your agent.">Copy prompt</button>
        </section>

        {(npmDeps.length > 0 || kuchiDeps.length > 0) && (
        <section aria-labelledby="cd-deps">
          <h2 id="cd-deps">Dependencies</h2>
          <ul class="cd-deps">
            {npmDeps.map((dep) => <li><code>{dep}</code></li>)}
            {kuchiDeps.map((dep) => (
              <li>
                {components.some((c) => c.name === dep)
                  ? <a href={`/components/${dep}`}><code>{dep}</code></a>
                  : <code>{dep}</code>}
                <span class="cd-dep-note">installed with it</span>
              </li>
            ))}
          </ul>
        </section>
        )}

        <p class="cd-registry">Registry item: <a href={`/r/${item.name}.json`}>/r/{item.name}.json</a></p>
      </aside>
    </div>

    <section class="cd-source" aria-labelledby="cd-source-title">
      <h2 id="cd-source-title">Source</h2>
      {files.map((file) => (
        <div class="cd-file">
          <SourceCode client:visible code={file.code} filename={file.path} />
        </div>
      ))}
    </section>

    {related.length > 0 && (
      <section class="cd-related" aria-labelledby="cd-related-title">
        <h2 id="cd-related-title">More {category.toLowerCase()} components</h2>
        <ul>
          {related.map((r) => (
            <li>
              <a href={`/components/${r.name}`}>
                <img src={posterUrl(r.name)} alt="" loading="lazy" decoding="async" width="640" height="360" />
                <span>{r.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <Toast />
  <SiteFooter />

  <script>
    // Page views and clicks, like every other page (privacy rules in analytics.mjs).
    void import('../../scripts/analytics.mjs').catch(() => null);
    let timer: number | undefined;
    const showToast = (message: string) => {
      const el = document.getElementById('toast');
      if (!el) return;
      el.textContent = message;
      el.classList.add('visible');
      clearTimeout(timer);
      timer = window.setTimeout(() => el.classList.remove('visible'), 2500);
    };
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-cmd]')) {
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copyCmd ?? '');
          showToast(button.dataset.copied ?? 'Install command copied');
        } catch {
          showToast('Copy failed. Select the command and copy it.');
        }
      });
    }
  </script>
</BaseLayout>

<style>
  /* One centred column like other component libraries: header, then the preview stage with the
     install panel beside it, then the source. */
  .cd-page {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 28px clamp(16px, 2.6vw, 40px) 96px;
  }
  .cd-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
    color: var(--k-muted);
    margin-bottom: 24px;
  }
  .cd-crumbs a { color: inherit; text-decoration: none; }
  .cd-crumbs a:hover { color: var(--k-ink, currentColor); text-decoration: underline; }
  .cd-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 380px);
    gap: clamp(24px, 3vw, 48px);
    align-items: start;
  }
  .cd-cat {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--k-muted);
  }
  .cd-head h1 {
    margin: 8px 0 12px;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .cd-head { margin-bottom: 28px; }
  .cd-desc { max-width: 70ch; color: var(--k-muted); line-height: 1.6; margin: 0 0 18px; }
  .cd-player { margin: 0; min-width: 0; }
  /* The preview sits centred on a framed, dotted stage. */
  .cd-stage {
    display: grid;
    place-items: center;
    padding: clamp(16px, 4vw, 48px);
    border: 1px solid var(--k-line);
    border-radius: 18px;
    background-color: var(--k-wash);
    background-image: radial-gradient(color-mix(in srgb, var(--k-ink) 14%, transparent) 1px, transparent 1px);
    background-size: 16px 16px;
    background-position: center;
  }
  .cd-stage video {
    display: block;
    width: 100%;
    max-width: 880px;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    background: #000;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08), 0 24px 48px -24px rgb(0 0 0 / 0.45);
  }
  .cd-player figcaption { margin-top: 10px; font-size: 13px; color: var(--k-muted); text-align: center; }
  .cd-side { display: flex; flex-direction: column; gap: 28px; position: sticky; top: 24px; }
  .cd-side h2, .cd-source h2, .cd-related h2 { font-size: 16px; margin: 0 0 10px; }
  .cd-side p { margin: 0 0 12px; color: var(--k-muted); line-height: 1.55; font-size: 14px; }
  .cd-cmd {
    display: flex;
    gap: 8px;
    align-items: center;
    border: 1px solid var(--k-line);
    border-radius: 10px;
    padding: 10px 10px 10px 12px;
    background: var(--k-wash);
  }
  .cd-cmd code { flex: 1; min-width: 0; overflow-wrap: anywhere; font-size: 12.5px; }
  .cd-deps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 13px; }
  .cd-dep-note { margin-left: 8px; color: var(--k-muted); font-size: 12px; }
  .cd-prompt {
    margin: 0 0 10px; padding: 12px 14px; border-radius: 12px;
    border: 1px solid var(--k-line); background: var(--k-wash);
    font-family: var(--font-prompt); font-size: 12.5px; line-height: 1.6; color: var(--k-ink);
    white-space: pre-wrap; overflow-wrap: anywhere;
  }
  .cd-registry { font-size: 13px !important; }
  .cd-source { margin-top: 56px; }
  .cd-file { margin-bottom: 14px; }
  .cd-related { margin-top: 56px; }
  .cd-related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 16px;
  }
  .cd-related a { display: flex; flex-direction: column; gap: 8px; color: inherit; text-decoration: none; font-size: 14px; }
  .cd-related img { width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--k-line); transition: opacity 160ms ease-out; }
  .cd-related a:hover img { opacity: 0.85; }
  @media (max-width: 900px) {
    .cd-grid { grid-template-columns: 1fr; }
    .cd-side { position: static; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cd-related img { transition: none; }
  }
</style>
