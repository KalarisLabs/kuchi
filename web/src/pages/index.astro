---
// Home: the hero, a handful of the newest launch videos (the full collection is at
// /videos), connecting an agent, and the FAQ. The gallery script plays the cards in the
// site player and forwards /#video-<id> links (remake briefs) to the video's own page.
import BaseLayout from '../layouts/BaseLayout.astro';
import SkipLink from '../components/SkipLink.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Intro from '../components/Intro.astro';
import AgentConnect from '../components/AgentConnect.astro';
import Faq from '../components/Faq.astro';
import LatestVideos from '../components/LatestVideos.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Toast from '../components/Toast.astro';
import { videos, newestFirst, totalImpressions } from '../lib/catalog';
import { SITE_URL } from '../lib/video-links.js';

// Nothing on this page depends on the request, so it is built once as static HTML.
export const prerender = true;

/** How many launch videos the home page shows. */
const HOME_VIDEOS = 9;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Kuchi',
    alternateName: 'Kuchi by Kalaris Labs',
    url: `${SITE_URL}/`,
    description: 'Launch-video references for AI agents, plus copy-paste Remotion video components.',
    publisher: { '@type': 'Organization', name: 'Kalaris Labs', url: 'https://kalarislabs.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SiteNavigationElement',
    name: ['Launch videos', 'Video components', 'Connect your agent'],
    url: [`${SITE_URL}/videos`, `${SITE_URL}/components`, `${SITE_URL}/#connect`],
  },
];
---
<BaseLayout
  title="Kuchi — Launch your idea before your product"
  description="Launch-video references, updated daily. Watch launch videos and connect your agent to the latest references with MCP."
  jsonLd={jsonLd}
>
  <SkipLink href="#latest" label="Skip to videos" />
  <SiteHeader />
  <main class="document">
    <Intro totalVideos={videos.length} totalImpressions={totalImpressions} />
    <LatestVideos videos={newestFirst.slice(0, HOME_VIDEOS)} total={videos.length} />
    <AgentConnect />
    <Faq />
  </main>

  <Toast />
  <noscript><p class="noscript">Enable JavaScript to play videos here. You can also <a href="/videos.json">download the metadata</a>.</p></noscript>
  <SiteFooter home />

  <script>
    import '../scripts/gallery.js';
  </script>
</BaseLayout>
