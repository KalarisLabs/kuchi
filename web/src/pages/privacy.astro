export const prerender = true;

const description = 'How Kuchi handles data: no accounts, no analytics cookies, IP addresses never stored with events, Do Not Track and Global Privacy Control honoured, and product details sent by your agent never stored. Rights under the DPDP Act, GDPR and US state laws.';
const toc = [
  { id: 'summary', label: 'In short' },
  { id: 'who-we-are', label: 'Who we are' },
