---
// /skills: every Kuchi agent skill, with the install command for each and a link to its raw
// SKILL.md. The flagship (product launch video) has its own page. Data: lib/skills.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import SkipLink from '../components/SkipLink.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SectionNav from '../components/SectionNav';
import SiteFooter from '../components/SiteFooter.astro';
import Toast from '../components/Toast.astro';
import SkillInstall from '../components/SkillInstall.astro';
import { SITE_URL } from '../lib/video-links.js';
import { skills, skillCommand, LAUNCH_SKILL_PATH, FLAGSHIP, SKILL_COMMAND } from '../lib/skills';

export const prerender = true;

const description = 'Free agent skills for making product launch videos: the end-to-end launch video skill, the Kuchi workflow, Remotion build, sound design and audio checks. Install with the skills CLI or get them all with the Kuchi MCP server.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Agent skills for product launch videos',
    description,
    url: `${SITE_URL}/skills`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: skills.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.title, url: s.name === FLAGSHIP ? `${SITE_URL}${LAUNCH_SKILL_PATH}` : s.url })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Kuchi', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Skills', item: `${SITE_URL}/skills` },
    ],
  },
];
const copyIcon = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
---
<BaseLayout title="Agent skills for product launch videos — Kuchi" description={description} jsonLd={jsonLd}>
  <SkipLink href="#skills-title" label="Skip to the skills" />
  <SiteHeader />
  <main class="document sh">
    <SectionNav client:load pathname={Astro.url.pathname} />
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Kuchi</a><span aria-hidden="true">/</span><span aria-current="page">Skills</span></nav>
    <header class="sh-hero">
      <h1 id="skills-title">Agent skills for launch videos</h1>
      <p>Skills are step-by-step methods your agent reads before it works. Kuchi's skills cover the whole launch video: the brief, the reference, the plan, the Remotion build, the sound and the checks. Every one comes with the MCP server, and each installs on its own with the skills CLI.</p>
      <div class="sh-cmd"><code>{SKILL_COMMAND}</code><button type="button" class="sh-copy" data-copy-text={SKILL_COMMAND} aria-label="Copy command to install every Kuchi skill" title="Copy" set:html={copyIcon} /></div>
      <p class="sh-hint">Installs every Kuchi skill; the CLI asks which ones and which agent.</p>
    </header>

    <ul class="sh-grid">
      {skills.map((s) => (
        <li class:list={['sh-card', { flagship: s.name === FLAGSHIP }]}>
          <p class="sh-name"><code>{s.name}</code>{s.name === FLAGSHIP && <span class="sh-badge">Start here</span>}</p>
          <h2>{s.name === FLAGSHIP ? <a href={LAUNCH_SKILL_PATH}>{s.title}</a> : s.title}</h2>
          <p>{s.summary}</p>
          <p class="sh-when"><strong>When:</strong> {s.when}</p>
          <div class="sh-code"><code>{skillCommand(s.name)}</code><button type="button" class="sh-copy" data-copy-text={skillCommand(s.name)} aria-label={`Copy install command for ${s.name}`} title="Copy" set:html={copyIcon} /></div>
          <p class="sh-links">{s.name === FLAGSHIP && <a href={LAUNCH_SKILL_PATH}>How it works →</a>}<a href={s.url} target="_blank" rel="noopener">SKILL.md ↗</a></p>
        </li>
      ))}
    </ul>

    <SkillInstall id="install" />
  </main>
  <Toast />
  <SiteFooter />
  <script>
    import '../scripts/agent-page';
  </script>
</BaseLayout>

<style>
  .sh { padding-top: 28px; }
  .crumbs { display: flex; gap: 8px; font-size: 13px; color: var(--k-muted); margin-bottom: 28px; }
  .crumbs a { color: var(--k-muted); text-decoration: none; }
  .crumbs [aria-current] { color: var(--k-ink); }
  .sh-hero { max-width: 760px; margin-bottom: 40px; }
  .sh-hero h1 { margin: 0 0 18px; font-size: clamp(34px, 5vw, 56px); line-height: 1.02; letter-spacing: -.04em; }
  .sh-hero > p { margin: 0 0 20px; color: var(--k-soft); font-size: 17px; line-height: 1.6; }
  .sh-hero .sh-hint { margin: 10px 0 0; color: var(--k-muted); font-size: 13.5px; }
  .sh-cmd, .sh-code { position: relative; padding: 11px 44px 11px 13px; border: 1px solid var(--k-line); border-radius: 10px; background: var(--k-wash); font-family: var(--k-mono); font-size: 13px; line-height: 1.5; overflow-wrap: anywhere; }
  .sh-copy { position: absolute; top: 6px; right: 6px; display: grid; place-items: center; width: 30px; height: 30px; border: 0; border-radius: 8px; background: transparent; color: var(--k-muted); cursor: pointer; transition: background-color 150ms ease, color 150ms ease, scale 160ms ease-out; }
  .sh-copy:active { scale: .94; }
  .sh-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
  .sh-card { display: flex; flex-direction: column; gap: 10px; min-width: 0; padding: 20px; border: 1px solid var(--k-line); border-radius: 14px; }
  .sh-card.flagship { border-color: var(--k-ink); }
  .sh-name { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 0; }
  .sh-name code { font-family: var(--k-mono); font-size: 12px; color: var(--k-muted); }
  .sh-badge { padding: 2px 8px; border-radius: 999px; background: var(--k-ink); color: var(--k-on-ink); font-size: 11.5px; font-weight: 600; }
  .sh-card h2 { margin: 0; font-size: 19px; letter-spacing: -.02em; }
  .sh-card h2 a { color: inherit; text-decoration: none; }
  .sh-card > p { margin: 0; color: var(--k-soft); font-size: 14.5px; line-height: 1.55; }
  .sh-card .sh-when { font-size: 13.5px; flex: 1; }
  .sh-links { display: flex; gap: 16px; font-size: 13.5px; }
  .sh-links a { color: var(--k-muted); text-decoration: none; }
  @media (hover: hover) and (pointer: fine) {
    .sh-copy:hover { background: var(--k-paper); color: var(--k-ink); }
    .sh-links a:hover, .sh-card h2 a:hover { color: var(--k-ink); text-decoration: underline; text-underline-offset: 3px; }
  }
</style>
