---
// /videos: the whole launch-video collection. The gallery script (scripts/gallery.js)
// drives the featured player, filters, grid/table and the quick-look dialog through the
// element ids these components render. Every card links to the video's own page.
import BaseLayout from '../layouts/BaseLayout.astro';
import SkipLink from '../components/SkipLink.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Featured from '../components/Featured.astro';
import Archive from '../components/Archive.astro';
import SourceNotes from '../components/SourceNotes.astro';
import SiteFooter from '../components/SiteFooter.astro';
import VideoDialog from '../components/VideoDialog.astro';
import Toast from '../components/Toast.astro';
import { videos, newestFirst } from '../lib/catalog';
import { compact } from '../lib/format.js';
import { totalImpressions } from '../lib/catalog';
import { SITE_URL, videoPath } from '../lib/video-links.js';

export const prerender = true;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Launch videos',
    url: `${SITE_URL}/videos`,
    description: `${videos.length} real product-launch videos from X, measured frame by frame, to use as templates for your own launch video.`,
    isPartOf: { '@type': 'WebSite', name: 'Kuchi', url: `${SITE_URL}/` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: videos.length,
      itemListElement: newestFirst.map((video, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `${SITE_URL}${videoPath(video)}`,
        name: video.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Kuchi', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Launch videos', item: `${SITE_URL}/videos` },
    ],
  },
];
---
<BaseLayout
  title="Launch videos · Kuchi"
  description={`Browse ${videos.length} viral product-launch videos from X: motion graphics, UI animation and kinetic type. Filter by style, watch, and copy a remake prompt for your agent.`}
  jsonLd={jsonLd}
>
  <SkipLink href="#archive" label="Skip to videos" />
  <SiteHeader />
  <main class="document">
    <header class="page-intro">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Kuchi</a><span aria-hidden="true">/</span><span aria-current="page">Launch videos</span></nav>
      <h1>Launch videos</h1>
      <p>{videos.length} real launches from X with {compact(totalImpressions)} impressions between them, measured frame by frame. Play any video, then copy its remake prompt into your agent.</p>
    </header>
    <Featured videos={videos} />
    <Archive videos={videos} />
    <SourceNotes />
  </main>

  <VideoDialog />
  <Toast />
  <noscript><p class="noscript">Enable JavaScript to filter the collection. Every video also has its own page; you can <a href="/videos.json">download the metadata</a>.</p></noscript>
  <SiteFooter />

  <script>
    import '../scripts/gallery.js';
  </script>
</BaseLayout>

<style>
  .page-intro { padding: 56px 0 8px; max-width: 760px; }
  .page-intro h1 { font-size: clamp(36px, 5vw, 56px); line-height: 1.02; letter-spacing: -0.045em; margin: 14px 0 14px; }
  .page-intro p { font-size: 16px; line-height: 1.55; color: var(--k-muted); margin: 0; max-width: 620px; }
  .crumbs { display: flex; gap: 8px; font-size: 13px; color: var(--k-muted); }
  .crumbs a { color: var(--k-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--k-ink); }
</style>
