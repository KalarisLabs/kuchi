{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Replaces site-worker/ as the gallery Worker. The MCP Worker (agent-service)
	// keeps its more specific routes (/mcp, /agent/*, /community/*), which win
	// over this catch-all route.
	"name": "kuchi-site",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "kuchi.kalarislabs.com/*", "zone_name": "kalarislabs.com" },
		{ "pattern": "status.kalarislabs.com/*", "zone_name": "kalarislabs.com" }
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"vars": {
		// MP4s are served from the kuchi-media R2 bucket on this custom domain.
		"KUCHI_MEDIA_URL": "https://kuchi-media.kalarislabs.com",
		// Product analytics, served first-party through /relay. A PostHog project
		// token is public by design. Set it to "" to switch analytics off.
		"POSTHOG_PROJECT_TOKEN": "phc_BaUCoMX79564auphbhPunCevdRfmVCzVRqk6Tdjz69kq",
		"POSTHOG_HOST": "https://us.i.posthog.com"
	},
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 0.1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.01 }
	}
}
